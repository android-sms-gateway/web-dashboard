# Environment Configuration Template for SMSGate Web Dashboard
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation
#
# Configuration is read from an optional YAML file (CONFIG_PATH), then a local
# .env file, then real environment variables (later sources win). Nested keys
# use a double underscore (__) separator.

# =============================================================================
# CI / GITHUB ACTIONS CONFIGURATION
# =============================================================================

# These are repository secrets used by .github/workflows/pr.yml (S3 upload of
# PR snapshot artifacts). They are NOT read by the application. Set them in the
# GitHub repo settings; never put real credentials in this file.

# AWS Region
# Purpose: Region for the S3-compatible bucket used to store PR build artifacts
# Format: AWS region string
# Example: eu-central-1
AWS_REGION=

# AWS Access Key ID
# Purpose: Access key for uploading PR snapshot artifacts to S3
# Format: String
# Example: AKIAIOSFODNN7EXAMPLE
AWS_KEY_ID=

# AWS Secret Access Key
# Purpose: Secret key paired with AWS_KEY_ID for the S3 upload step
# Format: String
# Example: your-secret-access-key
AWS_SECRET_ACCESS_KEY=

# AWS Bucket
# Purpose: Destination bucket (or bucket alias) for PR snapshot artifacts
# Format: Bucket name
# Example: my-build-artifacts
AWS_BUCKET=

# AWS Endpoint
# Purpose: S3 API endpoint (used for S3-compatible providers such as MinIO)
# Format: URL
# Example: https://s3.eu-central-1.amazonaws.com
AWS_ENDPOINT=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Optional YAML Config Path
# Purpose: Path to an optional YAML file with the same nested keys as the env
#          vars below (e.g. http.address, gateway.url); loaded before .env/env
# Format: File path
# Default: (unset — YAML file skipped when empty)
# Example: configs/config.yml
CONFIG_PATH=

# Debug Logging
# Purpose: Enables debug-level logging in the app logger (used by `make air`,
#          which starts the dev server with DEBUG=1)
# Format: Boolean (true|false|1|0)
# Default: (unset — debug off)
# Example: true
DEBUG=

# =============================================================================
# HTTP SERVER CONFIGURATION
# =============================================================================

# HTTP Listen Address
# Purpose: Bind address for the dashboard HTTP server (Fiber)
# Format: host:port
# Default: 127.0.0.1:3000
# Example: 127.0.0.1:3000
# Example: 0.0.0.0:3000
HTTP__ADDRESS=127.0.0.1:3000

# Trusted Proxy Header
# Purpose: Header carrying the real client IP when behind a reverse proxy;
#          used together with HTTP__PROXIES to trust proxy forwarding
# Format: HTTP header name
# Default: X-Forwarded-For
# Example: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# Trusted Proxies
# Purpose: List of proxy IPs/hops whose forwarded client headers are trusted;
#          empty list means no proxies are trusted
# Format: JSON array of strings
# Default: []
# Example: []
# Example: ["10.0.0.2","172.16.0.1"]
HTTP__PROXIES=[]

# OpenAPI Docs Enabled
# Purpose: Serves the OpenAPI/Swagger UI under /api/v1/docs when true
# Format: Boolean (true|false)
# Default: true
# Example: true
HTTP__OPENAPI__ENABLED=true

# OpenAPI Public Host
# Purpose: Override the host shown in generated OpenAPI docs when the service
#          is served behind a public hostname (empty = use request host)
# Format: hostname[:port]
# Default: (empty)
# Example: dashboard.example.com
HTTP__OPENAPI__PUBLIC_HOST=

# OpenAPI Public Path
# Purpose: Override the base path shown in generated OpenAPI docs when mounted
#          under a public path prefix (empty = use request path)
# Format: Path prefix
# Default: (empty)
# Example: /dashboard
HTTP__OPENAPI__PUBLIC_PATH=

# =============================================================================
# SMS GATEWAY API CONFIGURATION
# =============================================================================

# SMS Gateway 3rd Party API URL
# Purpose: Base URL of the SMSGate 3rd Party API that the dashboard proxies
#          (credential checks, webhooks, message/device management)
# Format: URL
# Default: https://api.sms-gate.app/3rdparty/v1
# Example: https://api.sms-gate.app/3rdparty/v1
# Example: http://localhost:8080/3rdparty/v1
GATEWAY__URL=https://api.sms-gate.app/3rdparty/v1

# =============================================================================
# WEBHOOK CALLBACK CONFIGURATION
# =============================================================================

# Public Webhook Callback URL
# Purpose: Public-facing URL of this dashboard registered on the gateway for
#          webhook events; must be reachable by the gateway
# Format: URL
# Default: http://localhost:3000/api/webhooks/callback
# Example: http://localhost:3000/api/webhooks/callback
# Example: https://dashboard.example.com/api/webhooks/callback
WEBHOOKS__URL=http://localhost:3000/api/webhooks/callback

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Trends Cache Backend
# Purpose: Backend used by the dashboard trends cache (in-memory or Redis)
# Format: URL (memory:// or redis://...)
# Default: memory://
# Example: memory://
# Example: redis://localhost:6379/0
CACHE__URL=memory://
