# Environment Configuration Template for web-dashboard
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation
#
# A file named .env in the working directory is loaded automatically at startup.
# Environment variables override values from .env and from CONFIG_PATH YAML.
# Nested keys use __ as the section separator (e.g. HTTP__ADDRESS -> http.address).

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Optional YAML Configuration File
# Purpose: Path to an optional YAML file with the same keys as the env vars below; loaded first, then .env and process env override it
# Format: File path
# Example: ./configs/config.yml
CONFIG_PATH=

# Debug Logging
# Purpose: Switches the zap logger from the production config to the development config (read by go-core-fx/logger)
# Format: Boolean (true|false)
# Default: false
# Example: true
DEBUG=false

# =============================================================================
# HTTP SERVER CONFIGURATION
# =============================================================================

# HTTP Server Bind Address
# Purpose: Host and port the dashboard HTTP server listens on (fiberfx)
# Format: host:port
# Default: 127.0.0.1:3000
# Example: 127.0.0.1:3000
# Example: 0.0.0.0:3000
HTTP__ADDRESS=127.0.0.1:3000

# Trusted Proxy Header
# Purpose: HTTP header that carries the real client IP when the dashboard runs behind a reverse proxy
# Format: HTTP header name
# Default: X-Forwarded-For
# Example: X-Forwarded-For
HTTP__PROXY_HEADER=X-Forwarded-For

# Trusted Proxies
# Purpose: List of proxy addresses trusted to set the proxy header; an empty list trusts no proxies
# Format: JSON array of IPs or CIDR ranges (values starting with [ are parsed as JSON arrays)
# Default: []
# Example: ["127.0.0.1"]
# Example: ["10.0.0.0/8"]
HTTP__PROXIES=[]

# =============================================================================
# OPENAPI / SWAGGER CONFIGURATION
# =============================================================================

# OpenAPI Docs Enabled
# Purpose: Serve the Swagger UI for the OpenAPI documentation at /api/v1/docs
# Format: Boolean (true|false)
# Default: true
# Example: true
HTTP__OPENAPI__ENABLED=true

# OpenAPI Public Host
# Purpose: Hostname shown in generated OpenAPI docs when the API is exposed publicly; empty uses the request host
# Format: Hostname (optional, no scheme)
# Example: api.example.com
HTTP__OPENAPI__PUBLIC_HOST=

# OpenAPI Public Path
# Purpose: Public path prefix for the API in generated OpenAPI docs; empty uses the actual path
# Format: URL path (optional, leading slash)
# Example: /api/v1
HTTP__OPENAPI__PUBLIC_PATH=

# =============================================================================
# SMS GATEWAY API CONFIGURATION
# =============================================================================

# SMSGate 3rd Party API Endpoint
# Purpose: Base URL of the SMSGate 3rd Party API the dashboard proxies for auth, messages, devices, and settings
# Format: URL
# Default: https://api.sms-gate.app/3rdparty/v1
# Example: https://api.sms-gate.app/3rdparty/v1
# Example: http://localhost:8080/3rdparty/v1
GATEWAY__URL=https://api.sms-gate.app/3rdparty/v1

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Webhook Callback URL
# Purpose: Public-facing URL registered with the SMSGate server for webhook event delivery to this dashboard
# Format: URL
# Default: http://localhost:3000/api/webhooks/callback
# Example: http://localhost:3000/api/webhooks/callback
# Example: https://dashboard.example.com/api/webhooks/callback
WEBHOOKS__URL=http://localhost:3000/api/webhooks/callback

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Trends Cache Backend
# Purpose: Backend used to cache dashboard trend statistics
# Format: URL (memory:// or redis://)
# Default: memory://
# Example: memory://
# Example: redis://localhost:6379/0
CACHE__URL=memory://

# =============================================================================
# CI CONFIGURATION (GitHub Actions only — not read by the application)
# =============================================================================

# AWS Region for CI artifact upload
# Purpose: Region for the S3-compatible bucket that stores PR build artifacts (pr.yml workflow)
# Format: AWS region string
# Example: us-east-1
AWS_REGION=

# AWS Access Key ID for CI artifact upload
# Purpose: Access key used by the PR workflow to upload build artifacts; never commit a real key
# Format: AWS access key ID
# Example: AKIAIOSFODNN7EXAMPLE
AWS_KEY_ID=

# AWS Secret Access Key for CI artifact upload
# Purpose: Secret key used by the PR workflow to upload build artifacts; never commit a real secret
# Format: AWS secret key
# Example: your-secret-access-key
AWS_SECRET_ACCESS_KEY=

# AWS Bucket for CI artifacts
# Purpose: Bucket (or prefix endpoint target) where PR build artifacts are uploaded
# Format: Bucket name
# Example: my-artifacts-bucket
AWS_BUCKET=

# AWS Endpoint for CI artifact upload
# Purpose: Custom S3-compatible endpoint URL; leave empty for standard AWS
# Format: URL
# Example: https://s3.example.com
AWS_ENDPOINT=
